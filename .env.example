# Server
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - must match the origin the frontend is served from
FRONTEND_URL=http://localhost:5500

# First admin account, used by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# AWS S3 - all uploads (profile picture, résumé/CV, project images) are
# stored here. Create a bucket, allow public read on the objects (or front
# it with CloudFront), and fill these in.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Email (contact form) - SMTP credentials used to SEND the email. The
# RECIPIENT is not set here: it's read dynamically from the Profile's
# "email" field, which you edit from the admin panel. Changing it there
# changes where contact-form messages go, with no redeploy needed.
# For Gmail: enable 2-Step Verification on the account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use
# that 16-character value as SMTP_PASS (your normal Gmail password will
# NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password

# Used only if the Profile document has no email set yet (first run,
# before you've saved anything in the admin panel).
CONTACT_FALLBACK_EMAIL=example23@gmail.com

# SEO / prerender (npm run prerender)
# Public URL of the site: used for canonical, og:url, sitemap.xml and robots.txt.
SITE_URL=https://abc.com
# Folder that contains the frontend's index.html (default: ../../frontend next to this backend).
# FRONTEND_DIR=/var/www/portfolio/frontend
# Optional: serve uploaded images through a CDN (e.g. CloudFront) instead of the raw S3 URL.
# AWS_PUBLIC_BASE_URL=https://d1234abcd.cloudfront.net
